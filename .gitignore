# Raw MRI data and rater outputs are NEVER committed.
*.nii
*.nii.gz

# Built workspace / QC outputs (live under workspace_root, but ignore if local).
workspace/
qc/
qc_out/
outputs/

# The group's own config and private files (see config/README.md).
config/local/

# Subject blinding key (workspace ID -> source ID) with its timestamped backups,
# and the per-phase manifests, which hold source IDs too. Written next to the
# config by split_subjects.py and phase_manifest.py; keep private (never share
# with raters).
config/subjects_split*.json
config/*_assignments*.csv
config/*_acquisitions*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# OS / editor
.DS_Store
*.swp
